<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/feedFragment">

    <fragment
        android:id="@+id/feedFragment"
        android:name="ru.netology.nework.ui.fragments.FeedFragment"
        android:label="AppName"
        tools:layout="@layout/fragment_feed">
        <action
            android:id="@+id/action_feedFragment_to_newPostFragment"
            app:destination="@id/newPostFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out" />
        <action
            android:id="@+id/action_feedFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_feedFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
        <action
            android:id="@+id/action_feedFragment_to_userFragment"
            app:destination="@id/userFragment" />
        <action
            android:id="@+id/action_feedFragment_to_eventsFeedFragment"
            app:destination="@id/eventsFeedFragment" />
    </fragment>

    <fragment
        android:id="@+id/eventsFeedFragment"
        android:name="ru.netology.nework.ui.fragments.events.EventsFeedFragment"
        android:label="Events"
        tools:layout="@layout/fragment_events_feed">

        <!-- Переход к созданию/редактированию события -->
        <action
            android:id="@+id/action_eventsFragment_to_newEventFragment"
            app:destination="@id/newEventFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out" />

        <!-- Переход к детальному просмотру события -->
        <action
            android:id="@+id/action_eventsFeedFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />

        <!-- Переход к авторизации (если пользователь не залогинен при клике на FAB) -->
        <action
            android:id="@+id/action_eventsFeedFragment_to_loginFragment"
            app:destination="@id/loginFragment" />

        <!-- Переход к профилю автора (по клику на аватар в карточке) -->
        <action
            android:id="@+id/action_eventsFeedFragment_to_userFragment"
            app:destination="@id/userFragment" />
    </fragment>

    <fragment
        android:id="@+id/usersFeedFragment"
        android:name="ru.netology.nework.ui.fragments.UsersFeedFragment"
        android:label="Users"
        tools:layout="@layout/fragment_user_jobs" />

    <fragment
        android:id="@+id/newPostFragment"
        android:name="ru.netology.nework.ui.fragments.NewPostFragment"
        android:label="New post"
        tools:layout="@layout/fragment_new_post">

        <argument
            android:name="postItemArg"
            android:defaultValue="@null"
            app:argType="ru.netology.nework.data.dto.post.PostItem"
            app:nullable="true" />

        <argument
            android:name="textArg"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>


    <fragment
        android:id="@+id/loginFragment"
        android:name="ru.netology.nework.ui.fragments.AuthFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="ru.netology.nework.ui.fragments.RegistrationFragment"
        android:label="Registration"
        tools:layout="@layout/fragment_registration">
        <action
            android:id="@+id/action_registrationFragment_to_feedFragment"
            app:destination="@id/feedFragment" />
    </fragment>

    <fragment
        android:id="@+id/userFragment"
        android:name="ru.netology.nework.ui.fragments.userfragment.UserFragment"
        android:label="UserFragment"
        tools:layout="@layout/fragment_user">

        <argument
            android:name="userIdArg"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/newEventFragment"
        android:name="ru.netology.nework.ui.fragments.events.NewEventFragment"
        android:label="NewEventFragment" />
    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="ru.netology.nework.ui.fragments.events.EventDetailFragment"
        android:label="EventDetailFragment" />

</navigation>